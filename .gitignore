# build artifacts
*.o
*.d
kurono
kurono-asan
kurono-tsan
kurono-ring-test
build/

# compiled tool binaries (extensionless), keep tool sources tracked
tools/*
!tools/*.c
!tools/*.h
# A tool source is a tool source whatever it is written in. Added at
# phase 12: tools/pty_drive.py was ignored by the rule above despite the
# rule's own stated intent, which is how phase 11's PTY harness was lost
# with its scratchpad and had to be written a second time.
!tools/*.py
# The fixture generator and its committed output (tools/gapless_test's
# inputs). Without these two lines both are silently untracked.
!tools/*.sh
!tools/fixtures/

# graphify knowledge graph output
graphify-out/

# process/scratch dirs, not source
plans/
commits/
status/
notes/
TODO.md
BUGS.md
IDEAS.md

# local editor/tool state
.claude/settings.local.json
compile_commands.json
.cache/
.stignore

# tools
.claudeignore
.graphifyignore
CLAUDE.md
DESIGN.md
music/
